diff --git a/src/dxvk/platform/dxvk_sdl2_exts.cpp b/src/dxvk/platform/dxvk_sdl2_exts.cpp
index 09de784..40148f8 100644
--- a/src/dxvk/platform/dxvk_sdl2_exts.cpp
+++ b/src/dxvk/platform/dxvk_sdl2_exts.cpp
@@ -13,6 +13,18 @@ namespace dxvk {
 
 
   DxvkNameSet DxvkPlatformExts::getInstanceExtensions() {
+#ifdef __ANDROID__
+    // Android SDL supports a single native window. Query the platform's
+    // extensions without creating a second window; balance the loader ref.
+    struct VulkanLoaderGuard {
+      VulkanLoaderGuard() {
+        if (SDL_Vulkan_LoadLibrary(nullptr) != 0)
+          throw DxvkError(str::format("SDL2 WSI: Failed to load Vulkan. ", SDL_GetError()));
+      }
+      ~VulkanLoaderGuard() { SDL_Vulkan_UnloadLibrary(); }
+    } loader;
+    SDL_Window* window = nullptr;
+#else
     SDL_Window* window = SDL_CreateWindow(
       "Dummy Window",
       SDL_WINDOWPOS_UNDEFINED,
@@ -23,6 +35,8 @@ namespace dxvk {
     if (window == nullptr)
       throw DxvkError(str::format("SDL2 WSI: Failed to create dummy window. ", SDL_GetError()));
 
+#endif
+
     uint32_t extensionCount = 0;
     if (!SDL_Vulkan_GetInstanceExtensions(window, &extensionCount, nullptr))
       throw DxvkError(str::format("SDL2 WSI: Failed to get instance extension count. ", SDL_GetError()));
@@ -35,7 +49,9 @@ namespace dxvk {
     for (const char* name : extensionNames)
       names.add(name);
 
+#ifndef __ANDROID__
     SDL_DestroyWindow(window);
+#endif
 
     return names;
   }
