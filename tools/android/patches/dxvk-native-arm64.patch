diff --git a/src/vulkan/vulkan_android_extent.h b/src/vulkan/vulkan_android_extent.h
new file mode 100644
index 0000000..a786065
--- /dev/null
+++ b/src/vulkan/vulkan_android_extent.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <algorithm>
+
+namespace dxvk::vk {
+  // Android permits imageExtent != currentExtent; currentExtent is the
+  // consumer's preferred size, which can lag a SurfaceView resize. The caller
+  // supplies the current view's pixel extent, NOT the D3D render resolution.
+  // Called only for Android full-surface presentation with identity transform.
+  // https://docs.vulkan.org/refpages/latest/refpages/source/vkCreateAndroidSurfaceKHR.html
+  template<typename Caps, typename Extent>
+  Extent pickAndroidViewExtent(const Caps& caps, Extent desired) {
+    // Zero returns are handled by Presenter::recreateSwapChain before creation.
+    // Never turn a suspended/unsupported surface into an artificial 1x1 chain.
+    if (!desired.width || !desired.height
+     || !caps.currentExtent.width || !caps.currentExtent.height
+     || !caps.maxImageExtent.width || !caps.maxImageExtent.height
+     || caps.minImageExtent.width > caps.maxImageExtent.width
+     || caps.minImageExtent.height > caps.maxImageExtent.height)
+      return { 0, 0 };
+    return {
+      std::clamp(desired.width, caps.minImageExtent.width, caps.maxImageExtent.width),
+      std::clamp(desired.height, caps.minImageExtent.height, caps.maxImageExtent.height) };
+  }
+}
