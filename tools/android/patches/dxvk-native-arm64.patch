diff --git a/src/d3d9/d3d9_present_extent.h b/src/d3d9/d3d9_present_extent.h
new file mode 100644
index 0000000..1feeba3
--- /dev/null
+++ b/src/d3d9/d3d9_present_extent.h
@@ -0,0 +1,17 @@
+#pragma once
+
+namespace dxvk {
+  // A null D3D9 destination means the complete output surface. Android's
+  // compositor owns buffer-to-view scaling; SDL logical dimensions need not
+  // equal the acquired Vulkan image extent. Keep explicit rectangles intact.
+  // Structural templates keep this coordinate policy independent of Vulkan
+  // headers; production uses VkRect2D/VkExtent2D, tests exercise the same code.
+  template<typename Rect, typename Extent>
+  Rect presentSurfaceRegion(Rect requested, Extent acquiredExtent, bool fullSurface) {
+    if (fullSurface) {
+      requested.offset = { 0, 0 };
+      requested.extent = acquiredExtent;
+    }
+    return requested;
+  }
+}
