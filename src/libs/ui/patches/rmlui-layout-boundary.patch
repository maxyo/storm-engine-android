+bool LayoutEngine::FormatBoundary(Element* element)
+{
+	RMLUI_ASSERT(element);
+	Box box = element->GetBox();
+	const Vector2f before = box.GetSize(BoxArea::Border);
+	Element* parent = element->GetParentNode();
+	// An automatic height in normal flow comes from the contents: formatted again from them, and compared. A flex
+	// item's or a set height is the one it has.
+	const bool flex_item = parent && (parent->GetDisplay() == Style::Display::Flex || parent->GetDisplay() == Style::Display::InlineFlex);
+	if (!flex_item && element->GetComputedValues().height().type == Style::Height::Auto)
+		box.SetContent(Vector2f(box.GetSize().x, -1.f));
+	RootBox root(parent ? parent->GetBox().GetSize() : before);
+	if (!FormattingContext::FormatIndependent(&root, element, &box, FormattingContextType::Block))
+		Log::Message(Log::LT_ERROR, "Error while formatting layout boundary: %s", element->GetAddress().c_str());
+	element->ClampScrollOffsetRecursive();
+	const Vector2f after = element->GetBox().GetSize(BoxArea::Border);
+	return Math::Absolute(after.x - before.x) < 0.01f && Math::Absolute(after.y - before.y) < 0.01f;
+}
