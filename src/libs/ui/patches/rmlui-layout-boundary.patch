+Element* Element::GetLayoutBoundary()
+{
+	Element* document = GetOwnerDocument();
+	for (Element* element = this; element && element != document; element = element->parent)
+	{
+		if (element->HasAttribute("rmlui-layout-boundary"))
+			return element;
+	}
+	return nullptr;
