+		// Storm Engine patch (bgfx-vulkan-pipeline-cache.patch): hands the device's pipeline cache to
+		// CallbackI::cacheWrite.
+		void stormSavePipelineCache()
+		{
+			size_t size = 0;
+
+			if (VK_SUCCESS == vkGetPipelineCacheData(m_device, m_pipelineCache, &size, NULL)
+			&&  0 < size)
+			{
+				void* data = bx::alloc(g_allocator, size);
+
+				// VK_INCOMPLETE (the cache grew meanwhile) still leaves valid data of `size` bytes.
+				if (0 <= vkGetPipelineCacheData(m_device, m_pipelineCache, &size, data) )
+				{
+					g_callback->cacheWrite(kStormPipelineCacheId, data, uint32_t(size) );
+				}
+
+				bx::free(g_allocator, data);
+			}
+
+			m_stormPipelinesUnsaved = 0;
+			m_stormFramesSinceSave  = 0;
+		}
