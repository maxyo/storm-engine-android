+			stormPipelineCreated(_job);
 			return pipeline;
 		}
 
+		// Render thread: a draw that cannot wait needs a pending pipeline now. Still queued: created here; being
+		// created on a pipeline thread: waited for, that one only.
+		::VkPipeline stormTakeBack(StormPipelineJob* _job, uint32_t _hash)
+		{
+			bool taken = false;
+			{
+				bx::MutexScope lock(m_stormLock);
+				if (StormPipelineJob::Queued == _job->status)
+				{
+					stormUnqueue(_job);
+					_job->status = StormPipelineJob::Running;
+					taken = true;
+				}
+			}
+
+			if (taken)
+			{
+				stormRemovePending(_job);
+				_job->flags &= ~kStormPipelineOffThread;
+				stormCreatePipeline(_job);
+				::VkPipeline pipeline = _job->pipeline;
+				stormPipelineCreated(_job);
+				return pipeline;
+			}
+
+			::VkPipeline pipeline = VK_NULL_HANDLE;
+			while (VK_NULL_HANDLE == (pipeline = m_pipelineStateCache.find(_hash) ) )
+			{
+				m_stormFinished.wait(2);
+				stormCollectPipelines();
+			}
+
+			return pipeline;
+		}
+
+		// Render thread: takes in what the pipeline threads have finished.
+		void stormCollectPipelines()
+		{
+			if (0 == m_stormNumPending)
+			{
+				return;
+			}
+
+			StormPipelineJob* done;
+			{
+				bx::MutexScope lock(m_stormLock);
+				done = m_stormDone;
+				m_stormDone = NULL;
+			}
+
+			while (NULL != done)
+			{
+				StormPipelineJob* job = done;
+				done = job->next;
+				stormRemovePending(job);
+				stormPipelineCreated(job);
+			}
+		}
+
+		// Render thread: before a shader or program goes (or every pipeline, both NULL), no pipeline thread may
+		// use it: its queued jobs are dropped (a draw asks for its pipeline again; a dropped prewarm is lost for
+		// this run) and the ones being created are waited for.
+		void stormDrainPipelines(const ShaderVK* _shader, const ProgramHandle* _program)
+		{
+			for (;;)
+			{
+				stormCollectPipelines();
+
+				bool running = false;
+				for (uint32_t ii = 0; ii < m_stormNumPending; )
+				{
+					StormPipelineJob* job = m_stormPendingJobs[ii];
+					const bool uses = (NULL == _shader && NULL == _program)
+						|| (NULL != _shader  && (job->vsh == _shader || job->fsh == _shader) )
+						|| (NULL != _program && job->program == _program->idx)
+						;
+
+					bool dropped = false;
+					if (uses)
+					{
+						bx::MutexScope lock(m_stormLock);
+						if (StormPipelineJob::Queued == job->status)
+						{
+							stormUnqueue(job);
+							dropped = true;
+						}
+						else
+						{
+							running = true;
+						}
+					}
+
+					if (dropped)
+					{
+						m_stormPendingJobs[ii] = m_stormPendingJobs[--m_stormNumPending];
+						s_stormJobsPending = m_stormNumPending;
+						bx::free(g_allocator, job);
+					}
+					else
+					{
+						++ii;
+					}
+				}
+
+				if (!running)
+				{
+					return;
+				}
+
+				m_stormFinished.wait(2);
+			}
+		}
+
+		// Render thread: the render pass getRenderPass made under this hash key, NULL when it was not recorded.
+		const StormRenderPassInfo* stormRenderPassInfo(uint32_t _hashKey) const
+		{
+			for (uint32_t ii = 0; ii < m_stormRenderPassNum; ++ii)
+			{
+				if (m_stormRenderPass[ii].hashKey == _hashKey)
+				{
+					return &m_stormRenderPass[ii];
+				}
+			}
+
+			return NULL;
+		}
+
+		// Render thread, at the start of a frame: the prewarm requests made after frames up to this one (their
+		// programs exist now) are queued for the pipeline threads.
+		void stormTakePrewarms(uint32_t _frameNum)
+		{
+			for (;;)
+			{
+				StormPrewarmRequest request;
+				{
+					bx::MutexScope lock(s_stormPrewarmLock);
+					uint32_t ii = 0;
+					while (ii < s_stormPrewarmNum && s_stormPrewarm[ii].frame > _frameNum)
+					{
+						++ii;
+					}
+
+					if (ii == s_stormPrewarmNum)
+					{
+						return;
+					}
+
+					bx::memCopy(&request, &s_stormPrewarm[ii], sizeof(request) );
+					s_stormPrewarm[ii] = s_stormPrewarm[--s_stormPrewarmNum];
+				}
+
+				stormPrewarm(request);
+			}
+		}
+
+		void stormPrewarm(const StormPrewarmRequest& _request)
+		{
+			const StormPipelineRecipe& recipe = _request.recipe;
+			const ProgramVK& program = m_program[_request.program.idx];
+
+			if (NULL == program.m_vsh)
+			{
+				// Destroyed before this frame (the host keeps the programs it prewarms: not expected).
+				BX_TRACE("Storm: a prewarm of program %d, which no longer exists, is dropped.", _request.program.idx);
+				return;
+			}
+
+			if (program.m_vsh->m_hash != recipe.vshHash
+			|| (NULL != program.m_fsh ? program.m_fsh->m_hash : 0) != recipe.fshHash
+			||  recipe.numStreams > BGFX_CONFIG_MAX_VERTEX_STREAMS
+			||  0 == recipe.rpNum
+			||  recipe.rpNum > BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS)
+			{
+				// Other shaders than the ones it was recorded with (the game or the engine changed): reported, so
+				// that the engine forgets it.
+				if (NULL != s_pipelineCreated)
+				{
+					s_pipelineCreated(program.m_vsh->m_stormName, NULL != program.m_fsh ? program.m_fsh->m_stormName : ""
+						, recipe.state, 0.0, kStormPipelinePrewarm | kStormPipelineUnusable, recipe.hash, &recipe, uint32_t(sizeof(recipe) ) );
+				}
+				return;
+			}
+
+			VkFormat formats[BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS];
+			VkImageAspectFlags aspects[BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS];
+			bool resolve[BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS];
+			for (uint8_t ii = 0; ii < recipe.rpNum; ++ii)
+			{
+				formats[ii] = VkFormat(recipe.rpFormats[ii]);
+				aspects[ii] = VkImageAspectFlags(recipe.rpAspects[ii]);
+				resolve[ii] = 0 != recipe.rpResolve[ii];
+			}
+
+			StormPipelineTarget target;
+			VK_CHECK(getRenderPass(recipe.rpNum, formats, aspects, 0 != recipe.rpHasResolve ? resolve : NULL, VkSampleCountFlagBits(recipe.rpSamples)
+				, recipe.rpClearFlags, recipe.rpDepthFlags, &target.renderPass, &target.renderPassHashKey) );
+			target.samples  = VkSampleCountFlagBits(recipe.rpSamples);
+			target.numBlend    = recipe.numBlend;
+			target.integerMask = recipe.integerMask;
+
+			const VertexLayout* layouts[BGFX_CONFIG_MAX_VERTEX_STREAMS];
+			for (uint8_t ii = 0; ii < recipe.numStreams; ++ii)
+			{
+				layouts[ii] = &recipe.layouts[ii];
+			}
+
+			stormGetPipeline(recipe.state, recipe.rgba, recipe.stencil, recipe.numStreams, layouts, _request.program, recipe.numInstanceData
+				, 0 != recipe.depthClamp, recipe.depthBias, recipe.slopeScale, recipe.biasClamp, recipe.sampleMask, StormPrewarm, target);
+		}
+
+		static int32_t stormPipelineThread(bx::Thread* /*_thread*/, void* _userData)
+		{
+			RendererContextVK* self = (RendererContextVK*)_userData;
+
+#if BX_PLATFORM_LINUX || BX_PLATFORM_ANDROID
+			// Below the game and render threads: a compile never takes their time.
+			if (0 != s_stormNice)
+			{
+				setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), s_stormNice);
+			}
+#endif // BX_PLATFORM_LINUX || BX_PLATFORM_ANDROID
+
+			for (;;)
+			{
+				self->m_stormWork.wait();
+
+				StormPipelineJob* job;
+				{
+					bx::MutexScope lock(self->m_stormLock);
+					job = self->m_stormQueueHead;
+					if (NULL != job)
+					{
+						self->stormUnqueue(job);
+						job->status = StormPipelineJob::Running;
+					}
+				}
+
+				if (NULL == job)
+				{
+					if (self->m_stormExit)
+					{
+						return 0;
+					}
+
+					continue;
+				}
+
+				self->stormCreatePipeline(job);
+
+				{
+					bx::MutexScope lock(self->m_stormLock);
+					job->status = StormPipelineJob::Done;
+					job->next = self->m_stormDone;
+					self->m_stormDone = job;
+				}
+				self->m_stormFinished.post();
+			}
+		}
