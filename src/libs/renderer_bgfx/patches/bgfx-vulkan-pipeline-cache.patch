+	bool prewarmVkPipeline(ProgramHandle _program, const void* _recipe, uint32_t _size, uint32_t _frame)
+	{
+		if (sizeof(vk::StormPipelineRecipe) != _size
+		||  vk::kStormRecipeMagic != *(const uint32_t*)_recipe
+		||  !isValid(_program) )
+		{
+			return false;
+		}
+
+		bx::MutexScope lock(vk::s_stormPrewarmLock);
+		if (vk::s_stormPrewarmNum == vk::s_stormPrewarmMax)
+		{
+			vk::s_stormPrewarmMax = bx::max<uint32_t>(64, vk::s_stormPrewarmMax * 2);
+			vk::s_stormPrewarm = (vk::StormPrewarmRequest*)bx::realloc(g_allocator, vk::s_stormPrewarm, vk::s_stormPrewarmMax * sizeof(vk::StormPrewarmRequest) );
+		}
+
+		vk::StormPrewarmRequest& request = vk::s_stormPrewarm[vk::s_stormPrewarmNum++];
+		request.frame   = _frame;
+		request.program = _program;
+		bx::memCopy(&request.recipe, _recipe, _size);
+		return true;
+	}
