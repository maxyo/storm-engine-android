The GL backend rewrites the transient vertex and index buffers every frame with a discarding update, which
deleted the buffer object and created a new one with storage for the whole limit (32 MB of vertices): a
full-size allocation and an implicit stall every frame (Tracy, emulator main menu: 33-56 ms per frame in
"bgfx/Update transient vertex buffer" for ~0.85 MB of vertices). Upstream bgfx master does the same.
With the patch the frames rotate through three buffer objects, each grown on demand to the largest range
written to it; a frame writes the buffer the GPU read two frames earlier, with glBufferSubData only.

diff --git a/src/renderer_gl.h b/src/renderer_gl.h
index 224b883..f473abf 100644
--- a/src/renderer_gl.h
+++ b/src/renderer_gl.h
@@ -1383,6 +1383,68 @@ namespace bgfx { namespace gl
 		GL_CHECK(glDeleteTextures(1, &_view.idx) );
 	}
 
+	// Storm Engine patch (renderer_bgfx/patches/bgfx-gl-transient-ring.patch). The transient buffers are
+	// rewritten every frame with _discard: re-creating the whole buffer (glDeleteBuffers + glBufferData of the
+	// full limit, 32 MB) stalled and allocated every frame. Instead the frames rotate through kSize buffer
+	// objects, each grown on demand to the largest range written to it (power of two, at least 64 KB, at most
+	// the limit): a frame writes the buffer the GPU last read kSize-1 frames ago, without a new allocation.
+	struct DiscardRingGL
+	{
+		static constexpr uint32_t kSize = 3;
+
+		// Called with the buffer's current id on each discarding update; returns the id to write and bind.
+		GLuint next(GLenum _target, GLuint _current, uint32_t _need, uint32_t _limit)
+		{
+			if (!m_active)
+			{
+				// The id bgfx created (with storage for the whole limit) becomes slot 0, re-specified on first use.
+				m_ids[0] = _current;
+				m_sizes[0] = 0;
+				for (uint32_t ii = 1; ii < kSize; ++ii)
+				{
+					GL_CHECK(glGenBuffers(1, &m_ids[ii]) );
+					m_sizes[ii] = 0;
+				}
+				m_index = 0;
+				m_active = true;
+			}
+			m_index = (m_index + 1) % kSize;
+			if (m_sizes[m_index] < _need)
+			{
+				uint32_t size = 64u << 10;
+				while (size < _need && size < _limit)
+				{
+					size *= 2;
+				}
+				size = bx::min(bx::max(size, _need), _limit);
+				GL_CHECK(glBindBuffer(_target, m_ids[m_index]) );
+				GL_CHECK(glBufferData(_target, size, NULL, GL_DYNAMIC_DRAW) );
+				m_sizes[m_index] = size;
+			}
+			return m_ids[m_index];
+		}
+
+		// Deletes every buffer of the ring (or just _current when the ring was never used).
+		void destroy(GLenum _target, GLuint _current)
+		{
+			GL_CHECK(glBindBuffer(_target, 0) );
+			if (m_active)
+			{
+				GL_CHECK(glDeleteBuffers(kSize, m_ids) );
+			}
+			else
+			{
+				GL_CHECK(glDeleteBuffers(1, &_current) );
+			}
+			m_active = false;
+		}
+
+		GLuint m_ids[kSize];
+		uint32_t m_sizes[kSize];
+		uint32_t m_index = 0;
+		bool m_active = false;
+	};
+
 	struct IndexBufferGL
 	{
 		void create(uint32_t _size, void* _data, uint16_t _flags)
@@ -1407,9 +1469,7 @@ namespace bgfx { namespace gl
 
 			if (_discard)
 			{
-				// orphan buffer...
-				destroy();
-				create(m_size, NULL, m_flags);
+				m_id = m_ring.next(GL_ELEMENT_ARRAY_BUFFER, m_id, _offset + _size, m_size);
 			}
 
 			GL_CHECK(glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m_id) );
@@ -1426,6 +1486,7 @@ namespace bgfx { namespace gl
 		GLuint m_id;
 		uint32_t m_size;
 		uint16_t m_flags;
+		DiscardRingGL m_ring;
 	};
 
 	struct VertexBufferGL
@@ -1455,9 +1516,7 @@ namespace bgfx { namespace gl
 
 			if (_discard)
 			{
-				// orphan buffer...
-				destroy();
-				create(m_size, NULL, m_layoutHandle, 0);
+				m_id = m_ring.next(m_target, m_id, _offset + _size, m_size);
 			}
 
 			GL_CHECK(glBindBuffer(m_target, m_id) );
@@ -1475,6 +1534,7 @@ namespace bgfx { namespace gl
 		GLenum m_target;
 		uint32_t m_size;
 		VertexLayoutHandle m_layoutHandle;
+		DiscardRingGL m_ring;
 	};
 
