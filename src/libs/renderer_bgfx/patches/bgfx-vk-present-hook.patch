+namespace bgfx
+{
+	/// Storm Engine patch (renderer_bgfx/patches/bgfx-vk-present-hook.patch): the host presents the Vulkan swap
+	/// chains itself (the engine: Android Frame Pacing, SwappyVk_queuePresent, src/shim/frame_pacing.cpp, which
+	/// declares the same struct and function). All three are called on the render thread. The handles are the
+	/// Vulkan ones: dispatchable handles as pointers, the swap chain as 64 bits.
+	struct VkPresentHooks
+	{
+		/// After vkCreateSwapchainKHR succeeded for the window `_nwh`.
+		void (*swapChainCreated)(void* _physicalDevice, void* _device, void* _queue, uint32_t _queueFamily, uint64_t _swapChain, void* _nwh);
+		/// Before the swap chain is released; it is destroyed later.
+		void (*swapChainDestroying)(void* _device, uint64_t _swapChain);
+		/// In place of vkQueuePresentKHR: `_presentInfo` is the VkPresentInfoKHR; returns the VkResult.
+		int32_t (*present)(void* _queue, const void* _presentInfo);
+	};
+
+	/// NULL (the default): bgfx presents with vkQueuePresentKHR. Set before bgfx::init, cleared after
+	/// bgfx::shutdown; the struct must outlive the device.
+	void setVkPresentHooks(const VkPresentHooks* _hooks);
+
+} // namespace bgfx
+
