The EGL backend presents the window surface of the context it created through a function the host sets
(bgfx::setEglPresent) instead of eglSwapBuffers: the engine presents with Android Frame Pacing
(SwappyGL_swap, src/shim/frame_pacing.cpp, which declares the same two functions), which times each present
to the display's vsync and picks the display mode. Without a function set, bgfx swaps with eglSwapBuffers.

diff --git a/src/glcontext_egl.cpp b/src/glcontext_egl.cpp
index 35a8afc6..4b4e1bb1 100644
--- a/src/glcontext_egl.cpp
+++ b/src/glcontext_egl.cpp
@@ -27,12 +27,28 @@
 #	define EGL_CHECK(_call) _call
 #endif // BGFX_CONFIG_DEBUG
 
+namespace bgfx
+{
+	/// Storm Engine patch (renderer_bgfx/patches/bgfx-swap-present-hook.patch): presents the window
+	/// surface of an EGL context that bgfx created itself, in place of eglSwapBuffers. `_display` and
+	/// `_surface` are its EGLDisplay and EGLSurface; returns false when the present failed. Called on
+	/// the render thread, in bgfx::frame(). The engine declares the same two functions where it sets one.
+	typedef bool (*EglPresentFn)(void* _display, void* _surface);
+
+	/// NULL (the default) swaps with eglSwapBuffers. Swap chains of createFrameBuffer(nwh) and
+	/// caller-provided contexts are not affected.
+	void setEglPresent(EglPresentFn _present);
+
+} // namespace bgfx
+
 namespace bgfx { namespace gl
 {
 #ifndef EGL_CONTEXT_FLAG_NO_ERROR_BIT_KHR
 #	define EGL_CONTEXT_FLAG_NO_ERROR_BIT_KHR 0x00000008
 #endif // EGL_CONTEXT_FLAG_NO_ERROR_BIT_KHR
 
+	static EglPresentFn s_eglPresent = NULL;
+
 #if BGFX_USE_GL_DYNAMIC_LIB
 
 #define EGL_IMPORT                                                            \
@@ -1160,7 +1176,15 @@ WL_EGL_IMPORT
 			&&  NULL != m_display
 			&&  EGL_NO_SURFACE != m_surface)
 			{
-				EGL_CHECK(eglSwapBuffers(m_display, m_surface) );
+				if (NULL != s_eglPresent)
+				{
+					// The host's present function reports its own failures.
+					s_eglPresent(m_display, m_surface);
+				}
+				else
+				{
+					EGL_CHECK(eglSwapBuffers(m_display, m_surface) );
+				}
 			}
 		}
 		else
@@ -1273,7 +1297,14 @@ WL_EGL_IMPORT
 		return imported;
 	}
 
-} /* namespace gl */ } // namespace bgfx
+} /* namespace gl */
+
+	void setEglPresent(EglPresentFn _present)
+	{
+		gl::s_eglPresent = _present;
+	}
+
+} // namespace bgfx
 
 #	endif // BGFX_USE_EGL
 #endif // (BGFX_CONFIG_RENDERER_OPENGLES || BGFX_CONFIG_RENDERER_OPENGL)
