--- a/src/glcontext_egl.cpp
+++ b/src/glcontext_egl.cpp
@@ -1092,7 +1092,11 @@ WL_EGL_IMPORT
 
 		if (NULL == _swapChain)
 		{
-			if (NULL != m_display
+			// A caller-provided context (PlatformData::context) belongs to a host that presents its
+			// surface itself (an Android GLSurfaceView swaps after onDrawFrame): a swap here as well
+			// presented a second, undrawn buffer every frame.
+			if (m_ownsContext
+			&&  NULL != m_display
 			&&  EGL_NO_SURFACE != m_surface)
 			{
 				EGL_CHECK(eglSwapBuffers(m_display, m_surface) );
