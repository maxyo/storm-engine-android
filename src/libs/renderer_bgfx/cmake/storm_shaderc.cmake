# Host shader compiler for the embedded shaders (host and cross builds alike): built from
# host-tools/ once per machine and bgfx pin into ${STORM_DEPS_CACHE}/shaderc-<digest of the
# pin, the bgfx patches and host-tools/CMakeLists.txt>, under a lock so concurrent builds of
# any worktree share one build. -DSTORM_SHADERC=<binary> overrides it explicitly.
set(STORM_SHADERC "" CACHE FILEPATH "Explicit host bgfx shaderc built from the pinned sources (host-tools/)")
if(STORM_SHADERC)
    if(NOT EXISTS "${STORM_SHADERC}")
        message(FATAL_ERROR "STORM_SHADERC=${STORM_SHADERC} does not exist")
    endif()
    set(storm_shaderc "${STORM_SHADERC}")
else()
    set(storm_shaderc_key "")
    file(GLOB storm_shaderc_inputs "${CMAKE_CURRENT_LIST_DIR}/bgfx_pin.cmake"
        "${CMAKE_CURRENT_LIST_DIR}/../host-tools/CMakeLists.txt" "${CMAKE_CURRENT_LIST_DIR}/../patches/bgfx-*.patch")
    foreach(input ${storm_shaderc_inputs})
        file(SHA256 "${input}" digest)
        string(APPEND storm_shaderc_key "${digest}")
    endforeach()
    string(SHA256 storm_shaderc_key "${storm_shaderc_key}")
    string(SUBSTRING "${storm_shaderc_key}" 0 16 storm_shaderc_key)
    set(storm_shaderc_dir "${STORM_DEPS_CACHE}/shaderc-${storm_shaderc_key}")
    set(storm_shaderc "${storm_shaderc_dir}/shaderc")
    if(NOT EXISTS "${storm_shaderc}")
        file(MAKE_DIRECTORY "${STORM_DEPS_CACHE}")
        file(LOCK "${storm_shaderc_dir}.lock" TIMEOUT 7200)
        if(NOT EXISTS "${storm_shaderc}")
            message(STATUS "Building the host shaderc once for this bgfx pin: ${storm_shaderc_dir}")
            foreach(step
                    "-S;${CMAKE_CURRENT_LIST_DIR}/../host-tools;-B;${storm_shaderc_dir}/build;-G;Ninja;-DCMAKE_BUILD_TYPE=Release;-DSTORM_DEPS_CACHE=${STORM_DEPS_CACHE}"
                    "--build;${storm_shaderc_dir}/build")
                execute_process(COMMAND "${CMAKE_COMMAND}" ${step} RESULT_VARIABLE result)
                if(NOT result EQUAL 0)
                    message(FATAL_ERROR "Building the host shaderc in ${storm_shaderc_dir}/build failed")
                endif()
            endforeach()
            file(COPY_FILE "${storm_shaderc_dir}/build/shaderc" "${storm_shaderc}.part")
            file(RENAME "${storm_shaderc}.part" "${storm_shaderc}")
        endif()
        file(LOCK "${storm_shaderc_dir}.lock" RELEASE)
    endif()
endif()
message(STATUS "Host shaderc: ${storm_shaderc}")
set(STORM_SHADERC_COMMAND "${storm_shaderc}" CACHE INTERNAL "")
set(STORM_SHADERC_DEPENDS "${storm_shaderc}" CACHE INTERNAL "")
