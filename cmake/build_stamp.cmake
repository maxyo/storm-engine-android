# The engine commit a native library was built from, readable in the built file: the string
# "storm-build-stamp:<commit>[+dirty]" in a kept symbol. The application's build_apk.py reads it
# from libengine.so and libstorm_ui.so and refuses a library built from another commit than the
# engine checkout it packages with (a stale library silently lacks newer engine code).
#
# The stamp is taken at configure time; the Android CI scripts configure on every build. A
# library built from a modified tree carries "+dirty" and matches any modified tree at that
# commit.
function(storm_build_stamp target)
    set(repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    execute_process(COMMAND git -C "${repo}" rev-parse HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE failed ERROR_QUIET)
    if(failed)
        message(FATAL_ERROR "build stamp: ${repo} is not a git checkout")
    endif()
    execute_process(COMMAND git -C "${repo}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND commit "+dirty")
    endif()
    set(source "${CMAKE_CURRENT_BINARY_DIR}/${target}_build_stamp.cpp")
    set(text "// Generated by cmake/build_stamp.cmake.\nextern \"C\" __attribute__((used, visibility(\"default\"))) const char storm_build_stamp[] = \"storm-build-stamp:${commit}\";\n")
    if(EXISTS "${source}")
        file(READ "${source}" old)
    endif()
    if(NOT old STREQUAL text) # rewritten only on change: an unchanged stamp recompiles nothing
        file(WRITE "${source}" "${text}")
    endif()
    target_sources(${target} PRIVATE "${source}")
endfunction()
