# Conan-free desktop Linux build used for renderer development and CI checks.
# Dependencies are the same pinned sources prepared for Android
# (tools/android/engine_sources.py) plus the distribution's SDL2 and zlib.
foreach(path STORM_HOST_SOURCES STORM_AUDIO_SOURCES)
    if(NOT IS_DIRECTORY "${${path}}")
        message(FATAL_ERROR "Set ${path} to a prepared dependency directory")
    endif()
endforeach()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
add_compile_options(-fsigned-char)
include_directories("${CMAKE_SOURCE_DIR}/third_party/d3d9-headers/directx" "${CMAKE_SOURCE_DIR}/third_party/d3d9-headers/windows")
set(FMT_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory("${STORM_HOST_SOURCES}/fmt" "${CMAKE_BINARY_DIR}/fmt" EXCLUDE_FROM_ALL)
find_package(SDL2 REQUIRED)
add_library(sdl INTERFACE)
target_link_libraries(sdl INTERFACE SDL2::SDL2)
set(SDL2_LIBRARIES sdl)
add_library(fast_float INTERFACE)
target_include_directories(fast_float INTERFACE "${STORM_HOST_SOURCES}/fast_float/include")
add_library(spdlog INTERFACE)
target_include_directories(spdlog INTERFACE "${STORM_HOST_SOURCES}/spdlog/include")
target_compile_definitions(spdlog INTERFACE SPDLOG_FMT_EXTERNAL)
target_link_libraries(spdlog INTERFACE fmt)
add_library(catch2 INTERFACE)
target_include_directories(catch2 INTERFACE "${STORM_HOST_SOURCES}/catch2/single_include")
set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(MI_BUILD_STATIC OFF CACHE BOOL "" FORCE)
set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)
add_subdirectory("${STORM_HOST_SOURCES}/mimalloc" "${CMAKE_BINARY_DIR}/mimalloc" EXCLUDE_FROM_ALL)
add_library(zlib INTERFACE)
target_link_libraries(zlib INTERFACE z)
add_library(storm_open_audio STATIC "${CMAKE_SOURCE_DIR}/android/audio/implementation.cpp" "${CMAKE_SOURCE_DIR}/android/audio/service_backend.cpp")
target_include_directories(storm_open_audio PUBLIC "${CMAKE_SOURCE_DIR}/android/audio" "${STORM_AUDIO_SOURCES}")
target_link_libraries(storm_open_audio PUBLIC dl m pthread)
include(ffmpeg)
storm_ffmpeg("${STORM_HOST_SOURCES}" host)
execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    OUTPUT_VARIABLE STORM_HOST_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE)
file(WRITE "${STORM_WATERMARK_FILE}" "#pragma once\n#define STORM_BUILD_WATERMARK Linux_host_${STORM_HOST_REVISION}_open_audio\n")
