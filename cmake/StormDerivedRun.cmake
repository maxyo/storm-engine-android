# The build step of storm_derived_files() (StormDerivedFiles.cmake), run with cmake -P. Under a lock: nothing to do when
# DIR is complete; else the venv of REQUIREMENTS (made once), the script into a scratch folder, every output checked
# against its digest, the folder renamed into place.
foreach(var NAME DIR PYTHON SCRIPT REQUIREMENTS SOURCES OUTPUTS PYTHON_CACHE)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "StormDerivedRun.cmake: ${var} is not set")
    endif()
endforeach()
string(REPLACE "|" ";" OUTPUTS "${OUTPUTS}")
string(REPLACE "|" ";" ARGS "${ARGS}")
string(REPLACE "|" ";" PIP_ARGS "${PIP_ARGS}")
string(REPLACE "|" ";" SOURCES "${SOURCES}")

get_filename_component(parent "${DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}" "${PYTHON_CACHE}")
file(LOCK "${DIR}.lock" TIMEOUT 7200)
if(EXISTS "${DIR}/.storm-complete")
    return()
endif()

# The venv: exact pins, nothing else (no dependencies resolved, binary wheels only), per requirements and Python.
execute_process(COMMAND "${PYTHON}" -c "import sys; print(sys.version)" OUTPUT_VARIABLE python_version
    OUTPUT_STRIP_TRAILING_WHITESPACE)
file(SHA256 "${REQUIREMENTS}" requirements_digest)
string(SHA256 venv_digest "${requirements_digest};${python_version};${PIP_ARGS}")
string(SUBSTRING "${venv_digest}" 0 16 venv_digest)
set(venv "${PYTHON_CACHE}/${venv_digest}")
file(LOCK "${venv}.lock" TIMEOUT 7200)
if(NOT EXISTS "${venv}/.storm-complete")
    message(STATUS "${NAME}: Python packages of ${REQUIREMENTS} into ${venv}")
    file(REMOVE_RECURSE "${venv}")
    execute_process(COMMAND "${PYTHON}" -m venv "${venv}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${NAME}: cannot make the venv ${venv} with ${PYTHON} (python3-venv installed?)")
    endif()
    set(pip "${venv}/bin/python" -m pip install --disable-pip-version-check --no-deps --only-binary=:all:)
    if(WHEELHOUSE)
        list(APPEND pip --no-index --find-links "${WHEELHOUSE}")
    endif()
    execute_process(COMMAND ${pip} ${PIP_ARGS} -r "${REQUIREMENTS}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        file(REMOVE_RECURSE "${venv}")
        message(FATAL_ERROR "${NAME}: pip could not install ${REQUIREMENTS} (offline: set STORM_PIP_WHEELHOUSE to a folder "
            "with those wheels)")
    endif()
    file(WRITE "${venv}/.storm-complete" "${REQUIREMENTS}\n${python_version}\n")
endif()
file(LOCK "${venv}.lock" RELEASE)

set(scratch "${DIR}.making")
file(REMOVE_RECURSE "${scratch}")
execute_process(COMMAND "${venv}/bin/python" -I "${SCRIPT}" --sources ${SOURCES} --output "${scratch}" ${ARGS}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    file(REMOVE_RECURSE "${scratch}")
    message(FATAL_ERROR "${NAME}: ${SCRIPT} failed")
endif()
foreach(pair ${OUTPUTS})
    string(REGEX MATCH "^([^=]+)=([0-9a-f]+)$" matched "${pair}")
    set(file "${CMAKE_MATCH_1}")
    set(expected "${CMAKE_MATCH_2}")
    if(NOT EXISTS "${scratch}/${file}")
        file(REMOVE_RECURSE "${scratch}")
        message(FATAL_ERROR "${NAME}: ${SCRIPT} made no ${file}")
    endif()
    file(SHA256 "${scratch}/${file}" digest)
    if(NOT digest STREQUAL expected)
        file(REMOVE_RECURSE "${scratch}")
        message(FATAL_ERROR "${NAME}: ${file} came out as sha256 ${digest}, not the pinned ${expected}: the toolchain "
            "(${REQUIREMENTS}, ${python_version}) makes other bytes. Nothing is kept.")
    endif()
endforeach()
file(REMOVE_RECURSE "${DIR}")
file(RENAME "${scratch}" "${DIR}")
file(WRITE "${DIR}/.storm-complete" "${SCRIPT}\n")
message(STATUS "${NAME}: made into ${DIR}")
